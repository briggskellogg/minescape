{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minescape.local/schemas/artifact-lock.schema.json",
  "title": "MineScape verified artifact lock",
  "type": "object",
  "required": ["schema", "minecraft", "java", "toolchain", "fabric_loader", "fabric_launcher", "artifacts"],
  "properties": {
    "schema": {"const": "minescape.artifacts.lock.v1"},
    "minecraft": {"const": "26.2"},
    "java": {"const": "Eclipse Temurin 25.0.3+9"},
    "toolchain": {"type": "object"},
    "fabric_loader": {"const": "0.19.3"},
    "fabric_launcher": {"const": "1.1.1"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "version", "version_id", "project_id", "filename", "size", "sha512", "download_url", "license", "provenance"],
        "properties": {
          "sha512": {"type": "string", "pattern": "^[a-f0-9]{128}$"},
          "download_url": {"type": "string", "pattern": "^https://cdn\\.modrinth\\.com/"},
          "size": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
