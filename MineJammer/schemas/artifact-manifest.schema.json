{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minescape.local/schemas/artifact-manifest.schema.json",
  "title": "MineScape pinned artifact source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "minecraft", "java", "toolchain", "fabric_loader", "fabric_launcher", "policy", "artifacts"],
  "properties": {
    "schema": {"const": "minescape.artifacts.source.v1"},
    "minecraft": {"const": "26.2"},
    "java": {"const": "Eclipse Temurin 25.0.3+9"},
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dotnet_sdk", "python", "gradle"],
      "properties": {
        "dotnet_sdk": {"const": "10.0.302"},
        "python": {"const": "3.13.14"},
        "gradle": {"const": "9.5.1"}
      }
    },
    "fabric_loader": {"const": "0.19.3"},
    "fabric_launcher": {"const": "1.1.1"},
    "policy": {"type": "object"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "provider", "project", "version", "version_id", "creator", "status", "profiles"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "name": {"type": "string"},
          "provider": {"const": "modrinth"},
          "project": {"type": "string"},
          "version": {"type": "string"},
          "version_id": {"type": "string", "pattern": "^[A-Za-z0-9]{8}$"},
          "creator": {"type": "string"},
          "status": {"type": "string"},
          "profiles": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "known_sha512": {"type": "string", "pattern": "^[a-f0-9]{128}$"}
        }
      }
    }
  }
}
