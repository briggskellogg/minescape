# MineScape keeps reconstructible source in Git; family/runtime state stays local.

# Runtime instances and permanent worlds
/var/
/backups/
/artifacts/cache/
/artifacts/downloads/
/artifacts/runtime/
/artifacts/*.zip
/artifacts/*.jar
*.mca
level.dat*
session.lock
usercache.json
whitelist.json
ops.json
banned-*.json

# Personal/security/exploration state
**/secrets.json
**/*.secret
**/*.key
**/*.pfx
**/players.db
**/minedeck.db
**/ledger.sqlite*
**/bluemap/web/
**/fog-data/
**/playerdata/
**/advancements/
**/stats/
**/logs/

# Third-party binaries and archives are reconstructed from the lock manifest
*.jar
*.zip
*.7z
*.tar
*.gz
!MineJammer/tests/fixtures/**/*.zip
!MineScape/gradle/wrapper/gradle-wrapper.jar

# Build outputs
**/bin/
**/obj/
**/build/
**/.gradle/
**/out/
TestResults/
.coverage
__pycache__/
*.py[cod]
.pytest_cache/

