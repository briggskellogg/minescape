/.tools/
/.dotnet/
/MineDeck/.dotnet-cli/
/MineDeck/.smoke-*/
/MineDeck/.smoke-*.json

# IDE / operating system
.vs/
.vscode/
.idea/
*.user
*.suo
*.tmp
*.log
Thumbs.db
.DS_Store

